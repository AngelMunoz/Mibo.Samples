binding dirtPatchOnGrassBottomLeft = dirt_patch_on_grass_bottom_left
binding dirtPatchOnGrassBottomRight = dirt_patch_on_grass_bottom_right
binding dirtPatchOnGrassCenter = dirt_patch_on_grass_center

group groundGrass = grassFullA, grassFullB, grassFullC
group groundDirt = dirtFullA, dirtFullB, dirtFullC
group pathDirt = pathVerticalDirt, pathHorizontalDirt, pathEndUpDirt, pathEndLeftDirt
group effects = effectImpactBurst, effectImpactRing, effectImpactDebris
group decoProps = bushSmall, rockSmall, rockMedium, rockLarge, crateMetalSquare, crateMetalBeveled, crateMetalDiamond, crateMetalOctagon, containerLarge, containerSmall, treeRound, treePine
group dirtBlends = dirtDotOnGrass, dirtCircleOnGrassTL, dirtCircleOnGrassTR, dirtCircleOnGrassBL, dirtCircleOnGrassBR, dirtPatchOnGrassTop, dirtPatchOnGrassBottom, dirtPatchOnGrassLeft, dirtPatchOnGrassRight, dirtPatchOnGrassTopLeft, dirtPatchOnGrassTopRight, dirtPatchOnGrassBottomLeft, dirtPatchOnGrassBottomRight, dirtPatchOnGrassCenter
group enemyHulls = tankHullGreen, tankHullBeige
group enemyPlanes = planeGreen, planeGray, planeGhostA, planeGhostB
