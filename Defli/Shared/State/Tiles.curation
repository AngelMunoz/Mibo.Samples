# Semantically named tiles for the tower-defense sheet.
# Consumed by tools/gen-tiles.fsx --preset defli.
# Groups list bindings, bindings list atlas sub-texture names.

binding grassFullA = grass_full_a
binding grassFullB = grass_full_b
binding grassFullC = grass_full_c
binding dirtFullA = dirt_full_a
binding dirtFullB = dirt_full_b
binding dirtFullC = dirt_full_c
binding pathVerticalDirt = path_vertical_dirt
binding pathHorizontalDirt = path_horizontal_dirt
binding pathEndUpDirt = path_end_up_dirt
binding pathEndLeftDirt = path_end_left_dirt
binding turretMountEmpty = turret_mount_empty
binding turretBaseA = turret_base_a
binding turretGreen = turret_green
binding turretRedDual = turret_red_dual
binding turretMissilesDual = turret_missiles_dual
binding tankTurretGreen = tank_turret_green
binding tankTurretBeige = tank_turret_beige
binding tankHullGreen = tank_hull_green
binding tankHullBeige = tank_hull_beige
binding planeGreen = plane_green
binding planeGray = plane_gray
binding planeGhostA = plane_ghost_a
binding planeGhostB = plane_ghost_b
binding rocketPodSingle = rocket_pod_single
binding rocketPodDual = rocket_pod_dual
binding rocketSmall = rocket_small
binding rocketLarge = rocket_large
binding coinGold = coin_gold
binding effectImpactBurst = effect_impact_burst
binding effectImpactRing = effect_impact_ring
binding effectImpactDebris = effect_impact_debris
binding crosshair = crosshair
binding bushSmall = bush_small
binding rockSmall = rock_small
binding rockMedium = rock_medium
binding rockLarge = rock_large
binding crateMetalSquare = crate_metal_square
binding crateMetalBeveled = crate_metal_beveled
binding crateMetalDiamond = crate_metal_diamond
binding crateMetalOctagon = crate_metal_octagon
binding containerLarge = container_large
binding containerSmall = container_small
binding treeRound = tree_round
binding treePine = tree_pine
binding dirtDotOnGrass = dirt_dot_on_grass
binding dirtCircleOnGrassTL = dirt_circle_on_grass_top_left
binding dirtCircleOnGrassTR = dirt_circle_on_grass_top_right
binding dirtCircleOnGrassBL = dirt_circle_on_grass_bottom_left
binding dirtCircleOnGrassBR = dirt_circle_on_grass_bottom_right
binding dirtPatchOnGrassTop = dirt_patch_on_grass_top
binding dirtPatchOnGrassBottom = dirt_patch_on_grass_bottom
binding dirtPatchOnGrassLeft = dirt_patch_on_grass_left
binding dirtPatchOnGrassRight = dirt_patch_on_grass_right
