<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Vulkan (DesktopVK) thin client for Defli.
    Shares all sources with the DX12 client (../MonoDX12) via linked files;
    only the runtime package and MonoGamePlatform differ. Mirrors the
    Platformer3D/MonoVK project structure.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <MonoGamePlatform>DesktopVK</MonoGamePlatform>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\MonoDX12\Types.fs">
      <Link>Types.fs</Link>
    </Compile>
    <Compile Include="..\MonoDX12\CameraView.fs">
      <Link>CameraView.fs</Link>
    </Compile>
    <Compile Include="..\MonoDX12\MapView.fs">
      <Link>MapView.fs</Link>
    </Compile>
    <Compile Include="..\MonoDX12\EnemiesView.fs">
      <Link>EnemiesView.fs</Link>
    </Compile>
    <Compile Include="..\MonoDX12\TowersView.fs">
      <Link>TowersView.fs</Link>
    </Compile>
    <Compile Include="..\MonoDX12\ProjectilesView.fs">
      <Link>ProjectilesView.fs</Link>
    </Compile>
    <Compile Include="..\MonoDX12\VfxView.fs">
      <Link>VfxView.fs</Link>
    </Compile>
    <Compile Include="..\MonoDX12\DiagnosticsView.fs">
      <Link>DiagnosticsView.fs</Link>
    </Compile>
    <Compile Include="..\MonoDX12\WorldView.fs">
      <Link>WorldView.fs</Link>
    </Compile>
    <Compile Include="..\MonoDX12\Program.fs">
      <Link>Program.fs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.fsproj" />
    <ProjectReference Include="..\..\Mibo\src\Mibo.MonoGame\Mibo.MonoGame.fsproj" />
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.5" />
    <PackageReference Include="MonoGame.Runtime.Windows.Vulkan" Version="3.8.5" />
    <PackageReference Include="MonoGame.Runtime.Mac.Vulkan" Version="3.8.5" />
    <PackageReference Include="MonoGame.Runtime.Linux.Vulkan" Version="3.8.5" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5" />
  </ItemGroup>
  <ItemGroup>
    <MonoGameContentReference Include="..\MonoDX12\Content\Content.mgcb">
      <Link>Content\Content.mgcb</Link>
    </MonoGameContentReference>
  </ItemGroup>
</Project>
