<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CameraView.fs" />
    <Compile Include="AuraView.fs" />
    <Compile Include="MapView.fs" />
    <Compile Include="EnemiesView.fs" />
    <Compile Include="TowersView.fs" />
    <Compile Include="ProjectilesView.fs" />
    <Compile Include="VfxView.fs" />
    <Compile Include="DiagnosticsView.fs" />
    <Compile Include="WorldView.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <!-- Assets are referenced from the repo-root shared assets dir — never
       duplicated. RecursiveDir does not include the anchored subdir, so the
       Link re-adds it explicitly. -->
  <ItemGroup>
    <Content Include="..\..\assets\kenney_particle_pack\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\kenney_particle_pack\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\assets\kenney_racing-pack\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\kenney_racing-pack\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\assets\kenney_smoke_particles\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\kenney_smoke_particles\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\assets\kenney_top-down-tanks-remastered\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\kenney_top-down-tanks-remastered\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\assets\kenney_tower-defense-top-down\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\kenney_tower-defense-top-down\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <!-- The aura GLSL shaders (the MonoGame clients build Aura.fx through
         Content.mgcb instead; only the loose GLSL pair is copied here). -->
    <Content Include="..\..\assets\shaders\aura.vs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\shaders\aura.vs</Link>
    </Content>
    <Content Include="..\..\assets\shaders\aura.frag">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\shaders\aura.frag</Link>
    </Content>
    <!-- The sound bank files (Application.AudioKeys' sources, registered in
         Program.fs; the MonoGame clients build the same files through
         Content.mgcb instead). -->
    <Content Include="..\..\assets\gun_sounds\7.62x39\762x39 Single MP3.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\gun_sounds\7.62x39\762x39 Single MP3.mp3</Link>
    </Content>
    <Content Include="..\..\assets\explosions\Medium_Explosion_1.ogg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\explosions\Medium_Explosion_1.ogg</Link>
    </Content>
    <Content Include="..\..\assets\explosions\Medium_Explosion_2.ogg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\explosions\Medium_Explosion_2.ogg</Link>
    </Content>
    <Content Include="..\..\assets\explosions\Small_Explosion.ogg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\explosions\Small_Explosion.ogg</Link>
    </Content>
    <Content Include="..\..\assets\horror_sfx\Scream_Robotic.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\horror_sfx\Scream_Robotic.wav</Link>
    </Content>
    <Content Include="..\..\assets\space_music_pack\fx\start-level.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\space_music_pack\fx\start-level.wav</Link>
    </Content>
    <Content Include="..\..\assets\space_music_pack\menu.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\space_music_pack\menu.wav</Link>
    </Content>
    <Content Include="..\..\assets\space_music_pack\battle.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\space_music_pack\battle.wav</Link>
    </Content>
    <Content Include="..\..\assets\horror_sfx\Child laugh.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\horror_sfx\Child laugh.wav</Link>
    </Content>
    <Content Include="..\..\assets\sfx_jump.ogg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\sfx_jump.ogg</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.fsproj" />
    <ProjectReference Include="..\..\Mibo\src\Mibo.Raylib.Adaptive\Mibo.Raylib.Adaptive.fsproj" />
  </ItemGroup>

</Project>
