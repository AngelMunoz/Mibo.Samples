<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Library.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Mibo\src\Mibo.MonoGame.Mvu\Mibo.MonoGame.Mvu.fsproj" />
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.5" PrivateAssets="all" />
  </ItemGroup>

  <!-- The clients build the shared content. A library ships no Content
       folder, and a second builder of the same .mgcb races them on the file
       MGCB writes above the content root. -->

</Project>
