<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MonoDX11 thin client for ModelProbe.
    Shares the ModelProbe/MonoShared library; only the runtime package
    differs. Mirrors the other ModelProbe clients.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MonoShared\MonoShared.fsproj" />
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.5" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5" />
  </ItemGroup>
  <ItemGroup>
  <!-- One .mgcb, four clients. MGCB writes the colormap it discovers for
       the models above the content root, at a path that ignores the
       platform, so two clients building at once lock the same file.
       Naming the output folder after the platform keeps them apart. -->
    <MonoGameContentReference Include="..\Content\Content.mgcb">
      <Link>Content\Content.mgcb</Link>
      <OutputFolder>Content/$(MonoGamePlatform)/Content</OutputFolder>
    </MonoGameContentReference>
  </ItemGroup>
</Project>
