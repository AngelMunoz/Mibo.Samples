<?xml version="1.0" encoding="utf-8"?>
<!-- blocks-3d.xml — the same map as blocks-3d.kdl, written in XML.
     A layer names itself with the `name` property. -->
<map w="32" h="20">
  <!-- ── the terrain ──────────────────────────────────────── -->
  <layer name="ground">
    <!-- rolling ground, at three heights -->
    <generate kernel="field" />

    <!-- a hill in the north-west -->
    <hill x="6" y="2" w="18" h="7" />

    <!-- a snowfield in the east -->
    <plot x="24" y="4" w="8" h="12"><generate kernel="snowfield" /></plot>
  </layer>

  <!-- ── what stands on it ────────────────────────────────── -->
  <layer name="decor">
    <!-- the woods along the top and the bottom -->
    <generate x="0" y="0" w="32" h="2" kernel="wood" />
    <generate x="0" y="18" w="32" h="2" kernel="wood" />

    <!-- the plants of the open field: stands of pines and loose stones,
         clear of the hill, the village, and the snowfield, so nothing is
         buried under a building or on the slope -->
    <plot x="0" y="2" w="3" h="16" pack="scatter" seed="11">
      <repeat count="8"><pineSmall /></repeat>
      <repeat count="4"><stones /></repeat>
    </plot>

    <plot x="19" y="16" w="5" h="2" pack="scatter" seed="12">
      <repeat count="4"><pineSmall /></repeat>
      <repeat count="2"><stones /></repeat>
    </plot>

    <plot x="24" y="2" w="8" h="2" pack="scatter" seed="13">
      <repeat count="4"><pineSmall /></repeat>
      <repeat count="2"><stones /></repeat>
    </plot>

    <!-- the snow trees of the snowfield -->
    <plot x="24" y="4" w="8" h="12" pack="scatter" seed="14">
      <repeat count="6"><snowTree /></repeat>
      <repeat count="4"><stones /></repeat>
    </plot>

    <!-- the village, from kernels the game baked out of Flow stamps -->
    <plot x="4" y="9" w="3" h="3"><generate kernel="hut" /></plot>
    <plot x="9" y="9" w="5" h="5"><generate kernel="yard" /></plot>
    <plot x="15" y="10" w="3" h="3"><generate kernel="tower" /></plot>

    <!-- the surface already carries a rampart; this map adds a keep of
         its own on top of it -->
    <rampart x="3" y="15" w="9" h="3" />
    <element name="keep">
      <fill cell="stones" />
      <border cell="wall" />
    </element>
    <keep x="14" y="15" w="5" h="4" />

    <!-- an avenue of pillars, four cells tall -->
    <plot x="20" y="6" w="1" h="10"><fill cell="pillar" /></plot>

    <!-- markers at the crossing -->
    <set x="20" y="5" cell="flag" />
    <set x="19" y="6" cell="ladder" />
    <set x="21" y="6" cell="sign" />
  </layer>
</map>
