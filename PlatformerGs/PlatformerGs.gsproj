<Project Sdk="Gsharp.NET.Sdk/0.4.273">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PlatformerGs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mibo\src\Mibo.Core\Mibo.Core.fsproj" />
    <ProjectReference Include="..\Mibo\src\Mibo.Raylib\Mibo.Raylib.fsproj" />
  </ItemGroup>

  <!-- Shared repo-root assets — never duplicated (mirrors Platformer/Raylib.fsproj). -->
  <ItemGroup>
    <Content Include="..\assets\kenney_platformer\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\kenney_platformer\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\assets\Fonts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\Fonts\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\assets\NormalMap.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\NormalMap.png</Link>
    </Content>
    <Content Include="..\assets\sfx_jump.ogg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\sfx_jump.ogg</Link>
    </Content>
  </ItemGroup>

</Project>
