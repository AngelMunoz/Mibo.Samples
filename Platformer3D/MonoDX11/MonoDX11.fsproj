<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DirectX 11 (WindowsDX) thin client for Platformer3D.
    Shares all sources with the DX12 client (../MonoGame) via linked files;
    only the runtime package differs. Mirrors the MonoVulkan/MonoGL projects
    and the FPSSample/MonoWindowsDX packaging.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\MonoGame\Types.fs">
      <Link>Types.fs</Link>
    </Compile>
    <Compile Include="..\MonoGame\Systems.fs">
      <Link>Systems.fs</Link>
    </Compile>
    <Compile Include="..\MonoGame\View.fs">
      <Link>View.fs</Link>
    </Compile>
    <Compile Include="..\MonoGame\MinimapView.fs">
      <Link>MinimapView.fs</Link>
    </Compile>
    <Compile Include="..\MonoGame\DiagnosticsView.fs">
      <Link>DiagnosticsView.fs</Link>
    </Compile>
    <Compile Include="..\MonoGame\Program.fs">
      <Link>Program.fs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.fsproj" />
    <ProjectReference Include="..\..\Mibo\src\Mibo.MonoGame\Mibo.MonoGame.fsproj" />
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.5" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5" />
  </ItemGroup>
  <ItemGroup>
    <MonoGameContentReference Include="..\MonoGame\Content\Content.mgcb">
      <Link>Content\Content.mgcb</Link>
    </MonoGameContentReference>
  </ItemGroup>
  <!-- Raw .glb for runtime animation loading (same as the DX12 client). -->
  <ItemGroup>
    <Content Include="..\assets\kaykit_character_animations\Rig_Medium_MovementBasic.glb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>animations\Rig_Medium_MovementBasic.glb</Link>
    </Content>
    <Content Include="..\assets\kaykit_character_animations\Rig_Medium_General.glb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>animations\Rig_Medium_General.glb</Link>
    </Content>
    <Content Include="..\assets\kaykit_character_animations\Textures\mannequin_texture.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>animations\mannequin_texture.png</Link>
    </Content>
    <!-- Raw kaykit weapons, loaded at runtime via AssimpNetter like the .glb
         above — deliberately NOT in the .mgcb content pipeline. -->
    <Content Include="..\assets\kaykit_fantasy_weapons\sword_A.gltf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>weapons\sword_A.gltf</Link>
    </Content>
    <Content Include="..\assets\kaykit_fantasy_weapons\sword_A.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>weapons\sword_A.bin</Link>
    </Content>
    <Content Include="..\assets\kaykit_fantasy_weapons\wand_A.gltf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>weapons\wand_A.gltf</Link>
    </Content>
    <Content Include="..\assets\kaykit_fantasy_weapons\wand_A.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>weapons\wand_A.bin</Link>
    </Content>
    <Content Include="..\assets\kaykit_fantasy_weapons\staff_B.gltf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>weapons\staff_B.gltf</Link>
    </Content>
    <Content Include="..\assets\kaykit_fantasy_weapons\staff_B.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>weapons\staff_B.bin</Link>
    </Content>
    <Content Include="..\assets\kaykit_fantasy_weapons\weapons_bits_texture.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>weapons\weapons_bits_texture.png</Link>
    </Content>
  </ItemGroup>
</Project>
