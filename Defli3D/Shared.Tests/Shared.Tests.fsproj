<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestData.fs" />
    <Compile Include="DomainTests.fs" />
    <Compile Include="MapTests.fs" />
    <Compile Include="BalanceTests.fs" />
    <Compile Include="EnemiesTests.fs" />
    <Compile Include="SpawningTests.fs" />
    <Compile Include="WavesTests.fs" />
    <Compile Include="EconomyTests.fs" />
    <Compile Include="ProjectionTests.fs" />
    <Compile Include="TowersTests.fs" />
    <Compile Include="ProjectilesTests.fs" />
    <Compile Include="ZonesTests.fs" />
    <Compile Include="CameraTests.fs" />
    <Compile Include="ApplicationTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Expecto" Version="10.*" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.15.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
  </ItemGroup>

</Project>
