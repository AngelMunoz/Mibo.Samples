<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Scratch diagnostic probe (NOT part of the game): renders line3D /
    plain-instanced / tinted-instanced / translucent-mesh draws through
    the real ForwardPipeline on the DX12 runtime into an offscreen RT,
    then reports pixel counts per hue. Used to determine why the
    MonoDX12 range indicators (line ring + tinted instanced preview)
    did not render. Deleted after the diagnosis; not in the final diff.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Mibo\src\Mibo.MonoGame\Mibo.MonoGame.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.5" />
    <PackageReference Include="MonoGame.Runtime.Windows.DX12" Version="3.8.5" />
  </ItemGroup>
</Project>
