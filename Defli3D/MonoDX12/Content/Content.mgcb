
#----------------------------- Global Properties ----------------------------#

/outputDir:Content
/intermediateDir:obj
/platform:WindowsDX12
/config:
/profile:HiDef
/compress:False

#-------------------------------- References --------------------------------#


#---------------------------------- Content ---------------------------------#

# The kenney_tower_defense_kit GLBs all reference one shared external texture
# (Models/Textures/colormap.png, relative URI). ModelProcessor auto-discovers
# it, but because the .fbx sources live outside this project the discovered
# texture escapes MGCB's output root and is never copied to the app, causing a
# ContentLoadException for colormap_0.xnb at runtime. Build the texture
# explicitly so it lands inside the output dir under the same content name the
# model embeds (assets/.../colormap_0), without moving any sources.
#begin ../../../assets/kenney_tower_defense_kit/Models/Textures/colormap.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyColor=0,0,0,0
/processorParam:ColorKeyEnabled=False
/processorParam:GenerateMipmaps=True
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:TextureFormat=Compressed
/build:../../../assets/kenney_tower_defense_kit/Models/Textures/colormap.png;assets/kenney_tower_defense_kit/Models/Textures/colormap_0

# The per-kind VFX textures (Defli parity) — the /build asset name
# mirrors the raylib loose path minus the extension, so the MonoGame
# view resolves the same logical keys through IAssets.

# VFX particle textures: mipmaps on so the 3D billboard stays soft when it is
# minified by perspective (the dense black smoke otherwise reads as a solid
# square). PremultiplyAlpha is the MGCB default but is set explicitly because
# it must stay on together with GenerateMipmaps.
#begin ../../../assets/kenney_particle_pack/spark_01.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:GenerateMipmaps=True
/processorParam:PremultiplyAlpha=True
/build:../../../assets/kenney_particle_pack/spark_01.png;kenney_particle_pack/spark_01

#begin ../../../assets/kenney_particle_pack/dirt_01.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:GenerateMipmaps=True
/processorParam:PremultiplyAlpha=True
/build:../../../assets/kenney_particle_pack/dirt_01.png;kenney_particle_pack/dirt_01

#begin ../../../assets/kenney_smoke_particles/Explosion/explosion03.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:GenerateMipmaps=True
/processorParam:PremultiplyAlpha=True
/build:../../../assets/kenney_smoke_particles/Explosion/explosion03.png;kenney_smoke_particles/Explosion/explosion03

#begin ../../../assets/kenney_smoke_particles/Black smoke/blackSmoke05.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:GenerateMipmaps=True
/processorParam:PremultiplyAlpha=True
/build:../../../assets/kenney_smoke_particles/Black smoke/blackSmoke05.png;kenney_smoke_particles/Black smoke/blackSmoke05

#begin ../../../assets/kenney_smoke_particles/Flash/flash00.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:GenerateMipmaps=True
/processorParam:PremultiplyAlpha=True
/build:../../../assets/kenney_smoke_particles/Flash/flash00.png;kenney_smoke_particles/Flash/flash00

# Boss body aura — a fresnel rim effect (drawn via DrawImmediate with an
# alpha blend + depth-read). Mirrors Platformer3D's Toon.fx build.
#begin Aura.fx
/importer:EffectImporter
/processor:EffectProcessor
/build:Aura.fx;Aura

