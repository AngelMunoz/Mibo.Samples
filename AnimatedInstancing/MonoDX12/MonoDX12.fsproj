<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <MonoGamePlatform>WindowsDX12</MonoGamePlatform>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Systems.fs" />
    <Compile Include="View.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.fsproj" />
    <ProjectReference Include="..\..\Mibo\src\Mibo.MonoGame\Mibo.MonoGame.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.5" />
    <PackageReference Include="MonoGame.Runtime.Windows.DX12" Version="3.8.5" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5" />
  </ItemGroup>
  <ItemGroup>
    <MonoGameContentReference Include="Content\Content.mgcb" />
  </ItemGroup>
  <!--
    AssimpNetter loads animation clips + skeleton from the raw rig .glbs at
    runtime (the MonoGame content pipeline does not preserve animation data in
    XNB). The raw .glbs live in Platformer3D's shared assets/ dir (same files
    the raylib backend uses) — referenced, never duplicated. They are copied to
    a separate 'animations' directory under the output dir, away from the
    content pipeline's 'Content' output. The renderable mannequin model
    (characters/Mannequin_Large.glb, texture embedded) goes through the .mgcb
    instead — see Content/Content.mgcb.
  -->
  <ItemGroup>
    <Content Include="..\..\assets\kaykit_character_animations\Rig_Medium_MovementBasic.glb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>animations\Rig_Medium_MovementBasic.glb</Link>
    </Content>
    <Content Include="..\..\assets\kaykit_character_animations\Rig_Medium_General.glb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>animations\Rig_Medium_General.glb</Link>
    </Content>
    <Content Include="..\..\assets\kaykit_character_animations\Rig_Large_MovementBasic.glb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>animations\Rig_Large_MovementBasic.glb</Link>
    </Content>
    <Content Include="..\..\assets\kaykit_character_animations\Rig_Large_General.glb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>animations\Rig_Large_General.glb</Link>
    </Content>
  </ItemGroup>
</Project>
